# The `https` profile of docker-compose.prod.yml: the app, artifact previews on a
# host of their own, and apps under their own domain.

{
	# An app gets its certificate on its first visit, once the gateway says the name is an app's.
	on_demand_tls {
		ask http://backend:8891/_viberglass/tls
	}
}

{$VIBERGLASS_DOMAIN} {
	reverse_proxy frontend:8080
}

{$VIBERGLASS_PREVIEW_DOMAIN} {
	reverse_proxy backend:8890
}

*.{$VIBERGLASS_APPS_DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy backend:8891
}
