# Settings for docker-compose.prod.yml. Copy to .env next to it and fill in the
# required values. Keep .env private: it holds the database password and the keys
# that encrypt stored credentials.

# --- Required ---------------------------------------------------------------

# The address people open Viberglass at. Must be HTTPS: sign-in cookies are secure.
VIBERGLASS_URL=https://viberglass.example.com

# Generate each with: openssl rand -hex 32
DB_PASSWORD=
SECRETS_ENCRYPTION_KEY=
WEBHOOK_SECRET_ENCRYPTION_KEY=

# --- HTTPS --------------------------------------------------------------------

# With `--profile https`, Caddy gets a certificate for this domain and serves on
# ports 80 and 443. Without it, put your own reverse proxy in front of
# VIBERGLASS_HTTP_PORT.
VIBERGLASS_DOMAIN=viberglass.example.com
# VIBERGLASS_HTTP_BIND=127.0.0.1
# VIBERGLASS_HTTP_PORT=8080

# --- Artifact previews ------------------------------------------------------------

# HTML, image and PDF artifacts preview from a host of their own, so the app's
# cookies never reach them. Use another hostname than VIBERGLASS_DOMAIN, with its
# DNS pointing at this host too. Caddy gets its certificate with `--profile https`;
# with your own proxy, send it to VIBERGLASS_PREVIEW_PORT. Leave both empty to
# turn these previews off.
VIBERGLASS_PREVIEW_URL=https://preview.viberglass.example.com
VIBERGLASS_PREVIEW_DOMAIN=preview.viberglass.example.com
# VIBERGLASS_PREVIEW_PORT=8890
# Preview links are signed with SECRETS_ENCRYPTION_KEY unless this is set.
# PREVIEW_SIGNING_KEY=

# --- Object storage -----------------------------------------------------------------

# Files spaces keep their files and artifacts in an S3-compatible bucket. Without
# one, spaces back onto Git repositories only. With a bucket set, task media and
# plan documents move to it too, and browsers download media from
# S3_PUBLIC_ENDPOINT. Agent containers fetch and save files through signed URLs
# for S3_WORKER_ENDPOINT, or S3_ENDPOINT when that's unset, so it must be an
# address they can reach from the Docker bridge network.
# S3_BUCKET=
# S3_ENDPOINT=https://s3.example.com
# S3_PUBLIC_ENDPOINT=
# S3_WORKER_ENDPOINT=
# S3_REGION=
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Images and data ------------------------------------------------------------

# A release tag such as v1.2.0 pins the backend and frontend images; latest follows main.
# VIBERGLASS_VERSION=latest
# VIBERGLASS_REGISTRY=ghcr.io/ilities
# Where agent worker images are pulled from.
# VIBERATOR_WORKER_REGISTRY=ghcr.io/ilities
# Task media, saved agent sessions, instruction files and skills, on the host.
# VIBERGLASS_DATA_DIR=/var/lib/viberglass

# Agent containers call the backend on the Docker bridge address. Change it if
# `ip addr show docker0` shows another address.
# VIBERGLASS_WORKER_API_BIND=172.17.0.1
# VIBERGLASS_WORKER_API_PORT=8888

# --- Optional -------------------------------------------------------------------

# Email for invites and notifications, e.g. SMTP_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_FROM="Viberglass <viberglass@example.com>"
# SMTP_URL=

# OpenTelemetry traces
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# WORKER_OTEL_EXPORTER_OTLP_ENDPOINT=

# LOG_LEVEL=info
