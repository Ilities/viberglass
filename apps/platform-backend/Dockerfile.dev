# Backend Development Container
# This container runs the backend API with hot-reload support via nodemon
# NOTE: Build from repository root for workspace dependencies: docker build -f apps/platform-backend/Dockerfile.dev .

FROM node:24-alpine

# Litestream restores a copy of an App space's data for an agent turn.
ARG LITESTREAM_VERSION=0.5.17
ARG LITESTREAM_SHA256_AMD64=cfb371176d164437ae869f8351cfde49bd1804ae71c61923f75c9cba9c9c006d
ARG LITESTREAM_SHA256_ARM64=f8ca4a050095c1efbda2c4365172e61bf9d955ea0d9ac42f448b52e51819baa5
RUN case "$(apk --print-arch)" in \
         x86_64) arch=x86_64; sum="$LITESTREAM_SHA256_AMD64" ;; \
         aarch64) arch=arm64; sum="$LITESTREAM_SHA256_ARM64" ;; \
         *) echo "Litestream has no build for $(apk --print-arch)" >&2; exit 1 ;; \
       esac \
    && wget -q -O /tmp/litestream.tar.gz "https://github.com/benbjohnson/litestream/releases/download/v${LITESTREAM_VERSION}/litestream-${LITESTREAM_VERSION}-linux-${arch}.tar.gz" \
    && echo "$sum  /tmp/litestream.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/litestream.tar.gz -C /usr/local/bin litestream \
    && rm /tmp/litestream.tar.gz

WORKDIR /app

# Copy monorepo root package.json for workspace resolution
COPY package*.json ./

# Create workspace directories and copy their package.json files
RUN mkdir -p apps/platform-backend packages/types packages/telemetry packages/model-hosting-verda packages/integration-core packages/platform-ui packages/mcp-server packages/agent-core packages/agents
COPY apps/platform-backend/package*.json ./apps/platform-backend/
COPY packages/types/package*.json ./packages/types/
COPY packages/telemetry/package*.json ./packages/telemetry/
COPY packages/model-hosting-verda/package*.json ./packages/model-hosting-verda/
COPY packages/integration-core/package*.json ./packages/integration-core/
COPY packages/platform-ui/package*.json ./packages/platform-ui/
COPY packages/mcp-server/package*.json ./packages/mcp-server/
COPY packages/agent-core/package*.json ./packages/agent-core/

# Integration plugins use a glob workspace; copy full source for package.json resolution
COPY packages/integrations ./packages/integrations

# Install all dependencies (workspace-aware from root)
RUN npm install --legacy-peer-deps

# Copy all workspace packages
# Note: In docker-compose, source is mounted via volume, overriding these copies
COPY packages/types ./packages/types
COPY packages/telemetry ./packages/telemetry
COPY packages/model-hosting-verda ./packages/model-hosting-verda
COPY packages/integration-core ./packages/integration-core
COPY packages/platform-ui ./packages/platform-ui
COPY packages/mcp-server ./packages/mcp-server
COPY packages/agent-core ./packages/agent-core
COPY apps/platform-backend ./apps/platform-backend

# Expose backend API port
EXPOSE 8888

# Set working directory to backend for running the server
WORKDIR /app/apps/platform-backend

# Workspace packages load from their dist/, which docker-compose.dev.yml mounts from
# the host along with their source: build them there first (npm run backend:build-deps).
CMD ["npm", "run", "dev"]
