{
  "name": "@viberator/e2e-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run stack:up && playwright test --project=smoke",
    "test:legacy": "playwright test --project=legacy",
    "test:headed": "playwright test --project=smoke --headed",
    "test:report": "playwright show-report",
    "stack:up": "docker compose -f docker/docker-compose.e2e.yaml down -v && docker compose -f docker/docker-compose.e2e.yaml up -d --wait",
    "stack:down": "docker compose -f docker/docker-compose.e2e.yaml down -v"
  },
  "dependencies": {
    "@playwright/test": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}
