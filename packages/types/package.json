{
  "name": "@viberglass/types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for Viberglass platform",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "generate:catalog": "tsx scripts/generate-worker-image-catalog.ts",
    "test": "jest",
    "test:unit": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
