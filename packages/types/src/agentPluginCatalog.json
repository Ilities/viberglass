  {
    "agent": "opencode",
    "label": "OpenCode",
    "description": "Coding agent with multiple model providers and customizable endpoints.",
    "logo": "/logos/agents/opencode.ico",
    "default": false,
    "testOnly": false,
    "endpointRank": 0,
    "apiKey": [
      "OPENCODE_API_KEY",
      "OPENAI_API_KEY"
    ],
    "endpoint": [
      "OPENCODE_BASE_URL",
      "OPENCODE_ENDPOINT",
      "OPENAI_BASE_URL"
    ],
    "harnessConfigFiles": [
      "opencode.json"
    ],
    "modelApiFormats": [
      "openai-chat",
      "anthropic-messages"
    ],
    "settings": [
      {
        "key": "endpoint",
        "label": "OpenCode Base URL",
        "type": "string",
        "env": [
          "OPENCODE_BASE_URL",
          "OPENAI_BASE_URL"
        ],
        "description": "Optional OpenAI-compatible endpoint override. Usually not needed: OpenCode sends requests to the right endpoint for the model.",
        "placeholder": "https://api.openai.com/v1",
        "providerDefault": "endpoint"
      },
      {
        "key": "model",
        "label": "OpenCode Model",
        "type": "string",
        "env": [
          "OPENCODE_MODEL"
        ],
        "description": "Optional model override, as `provider/model` (e.g. `minimax/minimax-2.7`). `opencode models` lists them.",
        "placeholder": "provider/model-name",
        "providerDefault": "model"
      }
    ],
    "harnessConfigEditor": {
      "fileType": "opencode.json",
      "label": "OpenCode Configuration",
      "envReferences": [
        "{env:NAME}"
      ],
      "template": "{\n  \"$schema\": \"https://opencode.ai/config.json\",\n  \"provider\": {\n    \"my-proxy\": {\n      \"npm\": \"@ai-sdk/openai-compatible\",\n      \"options\": {\n        \"baseURL\": \"https://llm-proxy.example.com/v1\",\n        \"apiKey\": \"{env:OPENAI_API_KEY}\"\n      },\n      \"models\": {\n        \"my-model\": { \"name\": \"My model\" }\n      }\n    }\n  }\n}"
    },
    "signInMethods": [],
    "lambdaUnsupportedReason": null,
    "rejectedKeyNote": null
  },
