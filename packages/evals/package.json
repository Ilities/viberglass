    "test": "jest",
    "test:unit": "jest",
    "report": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
