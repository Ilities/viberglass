{
  "name": "@viberglass/evals",
  "version": "1.0.0",
  "description": "Graders and reports over the Viberglass run-manifest corpus",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
